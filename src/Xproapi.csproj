<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Xproapi</RootNamespace>
    <AssemblyName>Xproapi</AssemblyName>
    <Version>1.0.0</Version>
    <PackageId>Xproapi</PackageId>
    <Description>C# client for the Xproapi X (Twitter) data API: profiles, followers, followings, tweets, search.</Description>
    <PackageProjectUrl>https://xproapi.com/docs</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xproapi.Tests" />
  </ItemGroup>

</Project>
